{
  "name": "haxford",
  "version": "0.3.0",
  "description": "A terminal AI agent harness with TUI",
  "type": "module",
  "bin": {
    "haxford": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --minify --outfile haxford ./src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@inkjs/ui": "^2.0.0",
    "ai": "^5.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "bun-types": "^1.3.0",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.0"
  }
}
